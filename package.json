{
  "name": "gridwright",
  "version": "0.1.0",
  "private": true,
  "description": "Pipeline end-to-end de maquetaci\u00f3n: de un nodo de Figma a un componente verificado",
  "license": "MIT",
  "author": "Luciano Balbiano",
  "repository": {
    "type": "git",
    "url": "https://github.com/BalbianoLuciano/gridwright.git"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.20.0",
  "scripts": {
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "gw": "node packages/cli/dist/index.js"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild"
    ]
  }
}
