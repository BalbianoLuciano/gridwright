{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    // page.evaluate bodies are serialized and run inside Chromium, so this
    // package legitimately compiles against both Node and the DOM.
    "lib": ["ES2023", "DOM", "DOM.Iterable"]
  },
  "include": ["src/**/*.ts"],
  "references": [{ "path": "../core" }]
}
